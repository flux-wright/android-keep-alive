<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.backgroundservice">

    <!-- 基础前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14/15+ 必须声明对应的具体类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Android 13+ 发送通知权限（前台服务必须挂通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 申请加入电池优化白名单（可选，视业务需求引导用户开启） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application ...>
        <!-- 声明后台执行服务，指定具体的 foregroundServiceType -->
        <service
            android:name=".ReliableBackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>
</manifest>
